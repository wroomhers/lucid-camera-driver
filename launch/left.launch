<launch>
  <arg name="config_file" value="$(find lyec_camera)/config/config.yaml"/>
  <arg name="cam_name" value="front_left_cam"/>
  <node name="$(arg cam_name)" pkg="lyec_camera" type="arena_camera_node" output="screen">
    <param name="config_file" value="$(arg config_file)"/>
    <param name="cam_name" value="$(arg cam_name)"/>
  </node>
</launch>